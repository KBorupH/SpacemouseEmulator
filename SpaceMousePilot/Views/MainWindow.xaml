<Window x:Class="SpaceMousePilot.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SpaceMousePilot"
        mc:Ignorable="d"
        xmlns:ctrl="clr-namespace:SpaceMousePilot.Controls"
        xmlns:vm="clr-namespace:SpaceMousePilot.ViewModels"
        xmlns:v="clr-namespace:SpaceMousePilot.Views"
        xmlns:conv="clr-namespace:SpaceMousePilot.Converters" d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
        Title="SpaceMouse Pilot"
        Width="480" SizeToContent="Height"
        ResizeMode="CanMinimize"
        Background="{StaticResource BrBg}"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI"
        Foreground="{StaticResource BrText}">

    <Window.Resources>
        <conv:BoolToColorConverter        x:Key="BoolColor"/>
        <conv:BoolToStringConverter       x:Key="BoolStr"/>
        <conv:StringToVisibilityConverter x:Key="StrVis"/>
        <conv:EnumDisplayConverter        x:Key="EnumDisplay"/>
        <BooleanToVisibilityConverter  x:Key="BoolVis"/>

        <!-- ── Meter row DataTemplate ── -->
        <DataTemplate DataType="{x:Type vm:MeterViewModel}">
            <Grid Margin="0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="78"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="40"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{Binding Label}"
                   FontSize="12" Foreground="{StaticResource BrMuted}"
                   VerticalAlignment="Center"/>
                <ctrl:AxisMeter Grid.Column="1" Height="14"
                        Value="{Binding Value}"
                        CalibPeak="{Binding CalibPeak}"
                        IsCalibMode="{Binding IsCalibMode}"/>
                <TextBlock Grid.Column="3" Text="{Binding ValueText}"
                   FontSize="11" FontFamily="Consolas"
                   Foreground="{Binding IsActive, Converter={StaticResource BoolColor}, ConverterParameter=#4DA6FF|#6A85A0}"
                   HorizontalAlignment="Right" VerticalAlignment="Center"/>
            </Grid>
        </DataTemplate>

        <!-- ── Axis settings DataTemplate ── -->
        <DataTemplate DataType="{x:Type vm:AxisViewModel}">
            <StackPanel Margin="12,10">
                <TextBlock Text="{Binding Hint}" FontSize="11"
                   Foreground="{StaticResource BrMuted}" Margin="0,0,0,10"/>

                <!-- Sensitivity -->
                <Grid Margin="0,3">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="90"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="44"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Sensitivity" FontSize="12" Foreground="{StaticResource BrMuted}" VerticalAlignment="Center"/>
                    <Slider Grid.Column="1" Style="{StaticResource SliderStyle}"
                  Minimum="0.1" Maximum="2.0" TickFrequency="0.05" IsSnapToTickEnabled="True"
                  Value="{Binding Sensitivity}" Margin="0,0,10,0"/>
                    <TextBlock Grid.Column="3" FontSize="11" FontFamily="Consolas"
                     Text="{Binding Sensitivity, StringFormat=F2}"
                     Foreground="{StaticResource BrText}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                </Grid>

                <!-- Deadzone -->
                <Grid Margin="0,3">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="90"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="44"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Deadzone" FontSize="12" Foreground="{StaticResource BrMuted}" VerticalAlignment="Center"/>
                    <Slider Grid.Column="1" Style="{StaticResource SliderStyle}"
                  Minimum="0" Maximum="0.30" TickFrequency="0.01" IsSnapToTickEnabled="True"
                  Value="{Binding Deadzone}" Margin="0,0,10,0"/>
                    <TextBlock Grid.Column="3" FontSize="11" FontFamily="Consolas"
                     Text="{Binding Deadzone, StringFormat=F2}"
                     Foreground="{StaticResource BrText}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                </Grid>

                <!-- Curve -->
                <Grid Margin="0,3">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="90"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="44"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Curve" FontSize="12" Foreground="{StaticResource BrMuted}" VerticalAlignment="Center"/>
                    <Slider Grid.Column="1" Style="{StaticResource SliderStyle}"
                  Minimum="1.0" Maximum="4.0" TickFrequency="0.1" IsSnapToTickEnabled="True"
                  Value="{Binding Curve}" Margin="0,0,10,0"/>
                    <TextBlock Grid.Column="3" FontSize="11" FontFamily="Consolas"
                     Text="{Binding Curve, StringFormat=F1}"
                     Foreground="{StaticResource BrText}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                </Grid>

                <!-- Scale -->
                <Grid Margin="0,3">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="90"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="44"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Scale" FontSize="12" Foreground="{StaticResource BrMuted}" VerticalAlignment="Center"/>
                    <Slider Grid.Column="1" Style="{StaticResource SliderStyle}"
                  Minimum="50" Maximum="1000" TickFrequency="10" IsSnapToTickEnabled="True"
                  Value="{Binding Scale}" Margin="0,0,10,0"/>
                    <TextBlock Grid.Column="3" FontSize="11" FontFamily="Consolas"
                     Text="{Binding Scale}"
                     Foreground="{StaticResource BrText}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                </Grid>

                <!-- Invert -->
                <Grid Margin="0,6,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="90"/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Invert" FontSize="12" Foreground="{StaticResource BrMuted}" VerticalAlignment="Center"/>
                    <CheckBox Grid.Column="1" Style="{StaticResource ToggleStyle}"
                    IsChecked="{Binding Invert}" VerticalAlignment="Center"/>
                </Grid>
            </StackPanel>
        </DataTemplate>

        <!-- ── Button mapping row DataTemplate ── -->
        <DataTemplate DataType="{x:Type vm:ButtonMappingViewModel}">
            <Grid Margin="0,3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="90"/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Label}" FontSize="12"
                   Foreground="{StaticResource BrMuted}" VerticalAlignment="Center"/>
                <ComboBox Grid.Column="1" Style="{StaticResource ComboStyle}"
                  ItemsSource="{Binding Options}"
                  SelectedItem="{Binding Selected}"
                  VerticalAlignment="Center">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Converter={StaticResource EnumDisplay}}"/>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
            </Grid>
        </DataTemplate>

    </Window.Resources>

    <DockPanel>

        <!-- menu bar -->
        <Border DockPanel.Dock="Top" Background="{StaticResource BrMenuBar}" Height="26">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="2,0">
                <Button Style="{StaticResource BtnMenu}" Content="Log"
                Command="{Binding OpenLogCommand}"/>
                <Button Style="{StaticResource BtnMenu}" Content="Config"
                Command="{Binding OpenConfigFolderCommand}"/>
            </StackPanel>
        </Border>

        <StackPanel Margin="22,16,22,20">

            <!-- header -->
            <StackPanel Orientation="Horizontal" Margin="0,0,0,18">
                <TextBlock Text="SpaceMouse Pilot" FontSize="20" FontWeight="Bold"/>
                <TextBlock Text="{Binding Version}" FontSize="11" Foreground="{StaticResource BrMuted}"
                   VerticalAlignment="Bottom" Margin="8,0,0,2"/>
            </StackPanel>

            <!-- status cards -->
            <Grid Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Background="{StaticResource BrBgCard}"
                BorderBrush="{StaticResource BrBorder}" BorderThickness="1"
                CornerRadius="10" Padding="14,12">
                    <StackPanel HorizontalAlignment="Center">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <Ellipse Width="10" Height="10" Margin="0,0,7,0"
                       Fill="{Binding SpacemouseOk, Converter={StaticResource BoolColor}}"/>
                            <TextBlock Text="SpaceMouse" FontSize="13" FontWeight="SemiBold"/>
                        </StackPanel>
                        <TextBlock Text="{Binding SpacemouseOk, Converter={StaticResource BoolStr}, ConverterParameter='Connected|Not connected'}"
                       FontSize="11" HorizontalAlignment="Center" Margin="0,3,0,0"
                       Foreground="{Binding SpacemouseOk, Converter={StaticResource BoolColor}, ConverterParameter=#4DA6FF|#6A85A0}"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Background="{StaticResource BrBgCard}"
                BorderBrush="{StaticResource BrBorder}" BorderThickness="1"
                CornerRadius="10" Padding="14,12">
                    <StackPanel HorizontalAlignment="Center">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <Ellipse Width="10" Height="10" Margin="0,0,7,0"
                       Fill="{Binding GamepadOk, Converter={StaticResource BoolColor}}"/>
                            <TextBlock Text="Virtual Controller" FontSize="13" FontWeight="SemiBold"/>
                        </StackPanel>
                        <TextBlock Text="{Binding GamepadOk, Converter={StaticResource BoolStr}, ConverterParameter='Ready|Not connected'}"
                       FontSize="11" HorizontalAlignment="Center" Margin="0,3,0,0"
                       Foreground="{Binding GamepadOk, Converter={StaticResource BoolColor}, ConverterParameter=#4DA6FF|#6A85A0}"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- start/stop button -->
            <Button Height="44" Margin="0,0,0,4"
              Command="{Binding ToggleBridgeCommand}"
              IsEnabled="{Binding IsNotStarting}">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource BtnAccent}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                <Setter Property="Background" Value="#C0392B"/>
                                <Setter Property="Foreground" Value="{StaticResource BrText}"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
                <TextBlock Text="{Binding IsRunning, Converter={StaticResource BoolStr},
                          ConverterParameter='Stop Bridge|Start Bridge'}"/>
            </Button>

            <!-- error -->
            <TextBlock Text="{Binding ErrorText}" FontSize="11"
                 Foreground="{StaticResource BrError}" TextWrapping="Wrap" Margin="0,2,0,0"
                 Visibility="{Binding ErrorText, Converter={StaticResource StrVis}}"/>
            <TextBlock Visibility="{Binding ShowVigemLink, Converter={StaticResource BoolVis}}"
                 Margin="0,2,0,0">
        <Hyperlink Command="{Binding OpenVigemLinkCommand}"
                   Foreground="{StaticResource BrAccent}">Download ViGEmBus →</Hyperlink>
            </TextBlock>

            <Separator Style="{StaticResource DividerStyle}"/>

            <!-- live input -->
            <TextBlock Text="LIVE INPUT" FontSize="10" FontWeight="Bold"
                 Foreground="{StaticResource BrMuted}" Margin="0,0,0,10"/>
            <ItemsControl ItemsSource="{Binding Meters}"/>

            <!-- calibrate -->
            <Grid Margin="0,10,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" Width="130" Style="{StaticResource BtnSecondary}"
                Command="{Binding CalibrateCommand}">
                    <TextBlock Text="{Binding IsCalibrating, Converter={StaticResource BoolStr},
                            ConverterParameter='Calibrating…|Calibrate axes'}"/>
                </Button>
                <TextBlock Grid.Column="1" Text="{Binding CalibHint}" FontSize="11"
                   Foreground="{Binding CalibHintUrgent, Converter={StaticResource BoolColor}, ConverterParameter=#F5A623|#6A85A0}"
                   VerticalAlignment="Center" Margin="10,0,0,0" TextWrapping="Wrap"/>
            </Grid>

            <ProgressBar Style="{StaticResource ProgressStyle}"
                   Visibility="{Binding IsCalibrating, Converter={StaticResource BoolVis}}"
                   Margin="0,6,0,0">
                <ProgressBar.Value>
                    <Binding Path="CalibProgress">
                        <Binding.Converter>
                            <conv:PercentConverter/>
                        </Binding.Converter>
                    </Binding>
                </ProgressBar.Value>
            </ProgressBar>

            <Separator Style="{StaticResource DividerStyle}"/>

            <!-- axis settings -->
            <TextBlock Text="AXIS SETTINGS" FontSize="10" FontWeight="Bold"
                 Foreground="{StaticResource BrMuted}" Margin="0,0,0,10"/>

            <TabControl Style="{StaticResource TabControlStyle}">

                <!-- Roll / Pitch / Yaw / Collective — ItemsControl generates tabs -->
                <TabItem Header="Roll"       Style="{StaticResource TabItemStyle}">
                    <ContentControl Content="{Binding AxisTabs[0]}"/>
                </TabItem>
                <TabItem Header="Pitch"      Style="{StaticResource TabItemStyle}">
                    <ContentControl Content="{Binding AxisTabs[1]}"/>
                </TabItem>
                <TabItem Header="Yaw"        Style="{StaticResource TabItemStyle}">
                    <ContentControl Content="{Binding AxisTabs[2]}"/>
                </TabItem>
                <TabItem Header="Collective" Style="{StaticResource TabItemStyle}">
                    <ContentControl Content="{Binding AxisTabs[3]}"/>
                </TabItem>

                <!-- Mapping tab -->
                <TabItem Header="Mapping" Style="{StaticResource TabItemStyle}">
                    <StackPanel Margin="12,10">
                        <TextBlock Text="AXIS OUTPUT" FontSize="10" FontWeight="Bold"
                       Foreground="{StaticResource BrMuted}" Margin="0,0,0,8"/>
                        <ItemsControl ItemsSource="{Binding MappingAxes}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:AxisViewModel}">
                                    <Grid Margin="0,3">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="90"/>
                                            <ColumnDefinition/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Label}" FontSize="12"
                               Foreground="{StaticResource BrMuted}" VerticalAlignment="Center"/>
                                        <ComboBox Grid.Column="1" Style="{StaticResource ComboStyle}"
                              ItemsSource="{Binding GamepadAxes}"
                              SelectedItem="{Binding Gamepad}"
                              VerticalAlignment="Center">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding Converter={StaticResource EnumDisplay}}"/>
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Separator Style="{StaticResource DividerStyle}"/>

                        <TextBlock Text="BUTTONS" FontSize="10" FontWeight="Bold"
                       Foreground="{StaticResource BrMuted}" Margin="0,0,0,8"/>
                        <ItemsControl ItemsSource="{Binding Buttons}"/>
                    </StackPanel>
                </TabItem>

                <!-- Performance tab -->
                <TabItem Header="Performance" Style="{StaticResource TabItemStyle}">
                    <StackPanel Margin="12,10">
                        <TextBlock Text="Changes take effect immediately" FontSize="11"
                       Foreground="{StaticResource BrMuted}" Margin="0,0,0,10"/>

                        <Grid Margin="0,3">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="90"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="44"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Bridge Hz" FontSize="12" Foreground="{StaticResource BrMuted}" VerticalAlignment="Center"/>
                            <Slider Grid.Column="1" Style="{StaticResource SliderStyle}"
                      Minimum="50" Maximum="1000" TickFrequency="50" IsSnapToTickEnabled="True"
                      Value="{Binding PollRateHz}" Margin="0,0,10,0"/>
                            <TextBlock Grid.Column="3" FontSize="11" FontFamily="Consolas"
                         Text="{Binding PollRateHz}"
                         Foreground="{StaticResource BrText}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </Grid>

                        <Grid Margin="0,3">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="90"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="44"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="UI Hz" FontSize="12" Foreground="{StaticResource BrMuted}" VerticalAlignment="Center"/>
                            <Slider Grid.Column="1" Style="{StaticResource SliderStyle}"
                      Minimum="10" Maximum="120" TickFrequency="5" IsSnapToTickEnabled="True"
                      Value="{Binding UiRefreshHz}" Margin="0,0,10,0"/>
                            <TextBlock Grid.Column="3" FontSize="11" FontFamily="Consolas"
                         Text="{Binding UiRefreshHz}"
                         Foreground="{StaticResource BrText}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </Grid>

                        <Grid Margin="0,3">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="90"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="44"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Calib secs" FontSize="12" Foreground="{StaticResource BrMuted}" VerticalAlignment="Center"/>
                            <Slider Grid.Column="1" Style="{StaticResource SliderStyle}"
                      Minimum="3" Maximum="30" TickFrequency="1" IsSnapToTickEnabled="True"
                      Value="{Binding CalibDurationS}" Margin="0,0,10,0"/>
                            <TextBlock Grid.Column="3" FontSize="11" FontFamily="Consolas"
                         Text="{Binding CalibDurationS, StringFormat=F0}"
                         Foreground="{StaticResource BrText}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </Grid>
                    </StackPanel>
                </TabItem>

            </TabControl>

            <!-- save row -->
            <Grid Margin="0,12,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{Binding SaveLabel}"
                   FontSize="11" Foreground="{StaticResource BrSuccess}"
                   VerticalAlignment="Center"/>
                <Button Grid.Column="1" Content="Save settings" Width="120"
                Style="{StaticResource BtnSecondary}"
                Command="{Binding SaveCommand}"/>
            </Grid>

        </StackPanel>
    </DockPanel>
</Window>

